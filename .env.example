# Copy this file to .env (which Git ignores) and replace every change_me value with your own.
# Never put real passwords or keys in this committed file.
#
# Optional, local only: also load the dev tools container (docker-compose.dev.yml), so that
# `docker compose run --rm dev pytest` works without extra flags.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml

APP_NAME=Pharma AI Development Assistant
ENVIRONMENT=local
LOG_LEVEL=INFO
# "json" (one JSON object per line, for servers) or "text" (readable, for local work).
# Both remove secrets, tokens, e-mail addresses and question/answer text before writing.
LOG_FORMAT=json

# Local PostgreSQL + pgvector settings
POSTGRES_DB=pharma_ai
POSTGRES_USER=pharma_ai
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pharma_ai:change_me_local_only@localhost:5432/pharma_ai
# Database for the tests, which erase their tables. It must be a different database, and its
# name must contain "test". Create it once with: python scripts/create_test_database.py
# TEST_DATABASE_URL=postgresql://pharma_ai:change_me_local_only@localhost:5432/pharma_test

# Where the audit trail is stored: "database" (default) or "memory". Memory keeps events only
# in the running process and is refused unless ENVIRONMENT is local or test. Use it to run the
# API on your machine without a database. With "database" the API needs the database to answer.
AUDIT_BACKEND=database

# Apache Tika Server (PDF & document extraction)
TIKA_PORT=9998
TIKA_URL=http://localhost:9998

# Document ingestion (S2-03). Original PDFs and their extracted text are kept in STORAGE_ROOT
# (a folder; compose uses a volume). EXTRACTION_ENGINE is "pypdf" (in-process) or "tika" (uses
# TIKA_URL and falls back to pypdf if Tika cannot be reached).
STORAGE_ROOT=data/storage
MAX_UPLOAD_MB=50
EXTRACTION_ENGINE=pypdf

# Chunking and embeddings (S2-06). scripts/index_chunks.py cuts the extracted text into passages of
# at most CHUNK_SIZE tokens (repeating the last CHUNK_OVERLAP tokens) and embeds each one. The model
# must give 384 numbers per passage. Changing any of these means running it again with --force.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# true: the API loads the model in the background at start-up, so the first search is not slow.
EMBEDDING_WARMUP=true

# Keycloak OIDC Identity Provider (Local Dev Realm)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local_only
OIDC_ISSUER_URL=http://localhost:8080/realms/pharma
OIDC_CLIENT_ID=pharma-ui

# API login mode: "oidc" (Keycloak) or "dev". Dev mode signs tokens with AUTH_DEV_SECRET and
# works without Keycloak; the API refuses it unless ENVIRONMENT is local or test.
# For dev mode set a long random AUTH_DEV_SECRET in your .env.
AUTH_MODE=oidc
AUTH_DEV_SECRET=

# API & Reverse Proxy Gateway Ports
API_PORT=8000
UI_PORT=5173
NGINX_PORT=8088

# Configure approved model endpoints/secrets only in your local .env.
# Never commit credentials or sensitive client data.
# LLM_PROVIDER=not_configured: no language model. Answers are made by matching the question's
#   words, and nothing leaves this machine.
# LLM_PROVIDER=xai: Grok picks the sentences to quote. The question and the retrieved passages are
#   sent to xAI. For development on public documents only.
LLM_PROVIDER=not_configured
# not_configured with xai means the default Grok model (ids: https://docs.x.ai/docs/models).
LLM_MODEL=not_configured
# The key goes in your own .env only, never here.
XAI_API_KEY=
# Must be https and an x.ai host.
XAI_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_SECONDS=30
