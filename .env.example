# Copy this file to .env (which Git ignores) and replace every change_me value with your own.
# Never put real passwords or keys in this committed file.
#
# Optional, local only: also load the dev tools container (docker-compose.dev.yml), so that
# `docker compose run --rm dev pytest` works without extra flags.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml

APP_NAME=Pharma AI Development Assistant
ENVIRONMENT=local
LOG_LEVEL=INFO

# Local PostgreSQL + pgvector settings
POSTGRES_DB=pharma_ai
POSTGRES_USER=pharma_ai
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pharma_ai:change_me_local_only@localhost:5432/pharma_ai
# Database for the tests, which erase their tables. It must be a different database, and its
# name must contain "test". Create it once with: python scripts/create_test_database.py
# TEST_DATABASE_URL=postgresql://pharma_ai:change_me_local_only@localhost:5432/pharma_test

# Where the audit trail is stored: "database" (default) or "memory". Memory keeps events only
# in the running process and is refused unless ENVIRONMENT is local or test. Use it to run the
# API on your machine without a database. With "database" the API needs the database to answer.
AUDIT_BACKEND=database

# Apache Tika Server (PDF & document extraction)
TIKA_PORT=9998
TIKA_URL=http://localhost:9998

# Keycloak OIDC Identity Provider (Local Dev Realm)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local_only
OIDC_ISSUER_URL=http://localhost:8080/realms/pharma
OIDC_CLIENT_ID=pharma-ui

# API login mode: "oidc" (Keycloak) or "dev". Dev mode signs tokens with AUTH_DEV_SECRET and
# works without Keycloak; the API refuses it unless ENVIRONMENT is local or test.
# For dev mode set a long random AUTH_DEV_SECRET in your .env.
AUTH_MODE=oidc
AUTH_DEV_SECRET=

# API & Reverse Proxy Gateway Ports
API_PORT=8000
NGINX_PORT=8088

# Configure approved model endpoints/secrets only in your local .env.
# Never commit credentials or sensitive client data.
LLM_PROVIDER=not_configured
LLM_MODEL=not_configured
